# Copy to .env and fill in. All services read from process env.
# This is a TEMPLATE — never put real secrets here (it is committed to git).

DATABASE_URL=postgres://hackos:hackos@localhost:5433/hackos
REDIS_URL=redis://localhost:6379

# Auth — generate long random strings for production
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# AI service (server-side only, never shipped to clients)
OPENAI_API_KEY=

# Object storage — MinIO locally, AWS S3 in production.
# Local MinIO:   S3_ENDPOINT=http://localhost:9000, keys = MinIO root creds.
# AWS S3:        leave S3_ENDPOINT empty (SDK derives it), set S3_REGION + IAM keys.
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hackos
S3_SECRET_KEY=hackos123
S3_BUCKET=hackos-uploads
# Optional: S3 access point alias, used as the bucket name when set.
S3_ACCESS_POINT_ALIAS=

# Public URL of the dashboard (used in OAuth redirect deep links)
WEB_URL=http://localhost:3000

# OAuth sign-in (Google / GitHub). Leave blank to disable — the API redirects back
# to /signin?error=oauth_not_configured instead of erroring.
# Google: https://console.cloud.google.com/apis/credentials → Create OAuth client ID
#   (Web application) and register this authorized redirect URI:
#   http://localhost:4010/v1/auth/oauth/google/callback
# GitHub: https://github.com/settings/developers → New OAuth App and register this
#   authorization callback URL:
#   http://localhost:4010/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of the API — used to build the redirect URIs above (change it in
# production and re-register the callback URLs with each provider)
OAUTH_CALLBACK_BASE=http://localhost:4010

# Service ports
API_PORT=4010
AI_PORT=4011
GATEWAY_PORT=4012
